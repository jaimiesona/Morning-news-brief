# ---------------------------------------------------------------------------
# Email delivery (required to actually receive the brief)
# Gmail: turn on 2-step verification, then create an App Password and use that
# here. Your normal Google password will not work.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_SUBJECT_PREFIX=Morning News Brief

# ---------------------------------------------------------------------------
# Collection
# ---------------------------------------------------------------------------
LOOKBACK_HOURS=26
FETCH_TIMEOUT=20
FETCH_WORKERS=8
# Google News locale. UK-weighted by default; US:en / en-US / US for US weighting.
GOOGLE_NEWS_LOCALE=GB:en
GOOGLE_NEWS_LANGUAGE=en-GB
GOOGLE_NEWS_COUNTRY=GB

# ---------------------------------------------------------------------------
# Article fetching. Pulls the opening of the page for stories that make the
# brief, so summaries say what a thing IS, not just that it happened.
# Set FETCH_ARTICLES=false to skip it (faster, much thinner summaries).
# ---------------------------------------------------------------------------
FETCH_ARTICLES=true
MAX_ARTICLE_FETCHES=30
ARTICLE_TIMEOUT=12
MAX_PUBLISHER_LOOKUPS=3

# ---------------------------------------------------------------------------
# Sections and volume
# ---------------------------------------------------------------------------
SECTIONS=ai,politics,technology,funding
MAX_STORIES_AI=6
MAX_STORIES_POLITICS=5
MAX_STORIES_TECHNOLOGY=5
MAX_FUNDING_ITEMS=8
MAX_EXTRA_HEADLINES=4

# ---------------------------------------------------------------------------
# Region preference (mainly boosts the funding radar)
# ---------------------------------------------------------------------------
PREFERRED_REGIONS=uk,united kingdom,britain,london,europe,european,eu,ireland,germany,france
REGION_BOOST=2.0

# ---------------------------------------------------------------------------
# Deduplication / ranking. Lower DEDUPE_THRESHOLD = more aggressive merging.
# ---------------------------------------------------------------------------
DEDUPE_THRESHOLD=0.42
CORROBORATION_WEIGHT=2.2
RECENCY_WEIGHT=2.0
KEYWORD_WEIGHT=1.0
SOURCE_WEIGHT=1.0

# ---------------------------------------------------------------------------
# Summarisation
#   extractive = free, no API, quotes the sources (default)
#   llm        = send source text to a model for real explanations
# ---------------------------------------------------------------------------
SUMMARISER=extractive
# LLM_PROVIDER=anthropic          # anthropic | openai_compatible
# LLM_MODEL=claude-opus-5         # or claude-sonnet-5 / claude-haiku-4-5 (cheaper)
# LLM_API_KEY=sk-ant-...
# LLM_EFFORT=low                  # low | medium | high — main cost dial
# LLM_MAX_STORIES=20              # hard cap on model calls per run
# LLM_BASE_URL=                   # openai_compatible only, e.g. http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
TIMEZONE=Europe/London
OUTPUT_DIR=output
SAVE_HTML=true
SEND_EMAIL=true
LOG_LEVEL=INFO
